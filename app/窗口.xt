// 窗口.xt — M2 窗口内降级版主循环（macOS，渲染库 raylib）
//
// 定位：M3 全局 CGEventTap 工具链未通之前的备用练手版。
// 只在【点中本窗口、窗口聚焦】时响应按键/鼠标，不是全局监听（那是 M3）。
//
// 音源：直接用渲染库 R.加载音效 播 resource/audios 下的真实 wav（绕过待修的封装音频库）。
// 键码说明：字母段 raylib 键码 = ASCII = Windows VK（J=74/M=77/N=78/T=84/H=72/L=76/W=87），
//           键盘直接查表命中才播；鼠标沿用原版随机池 {74,77,78,84} 随机播。

引 "渲染" 予 R
引 "./输入.xt" 予 输入
引 "./状态.xt" 予 状态
引 "./随机.xt" 予 随机

// 已入库的数字音效编号（对应 resource/audios/<编号>.wav）
设 音效编号 = [72, 74, 76, 77, 78, 84, 87, 229]
// 鼠标随机池（对照 C++ mouse_hook.cpp 写死的 {74,77,78,84}）
设 鼠标池 = [74, 77, 78, 84]

公 函 运行() {
    R.初始化窗口(460, 280, "KeyBonk M2 窗口内降级版")
    R.初始化音频()

    // 预加载全部真实 wav：编号 → 音效句柄
    设 表 = {}
    遍历 n 于 音效编号 {
        表[n] = R.加载音效("../resource/audios/" & n.转字() & ".wav")
    }

    设 最近键 = 0
    设 最近音效 = 0

    当 非 R.窗口应关闭?() {
        // ── 键盘：取队列里所有刚按下的键（取按键 返回 0 = 队列空）──
        设 k = R.取按键()
        当 k != 0 {
            最近键 = k
            若 非 状态.取键盘静音() {
                输入.键盘按下(k)
                // raylib 字母键码=ASCII，与 Windows VK 字母段数值一致，直接查表命中才播
                // （J=74/M=77/N=78/T=84/H=72/L=76/W=87），未命中的键不响，复刻原版 find 命中才播
                若 表.包含?(k) {
                    最近音效 = k
                    R.播音效(表[k])
                }
            }
            k = R.取按键()
        }

        // ── 鼠标：左键(0)/右键(1)，静音判断后按原版随机池播 ──
        若 非 状态.取鼠标静音() {
            若 R.鼠标刚按下?(0) 或 R.鼠标刚按下?(1) {
                输入.鼠标按下()
                设 选值 = 鼠标池[随机.取整数(0, 鼠标池.长度 - 1)]
                最近音效 = 选值
                若 表.包含?(选值) {
                    R.播音效(表[选值])
                }
            }
        }

        R.开始绘图()
        R.清背景(24, 24, 30, 255)
        R.绘文字("KeyBonk M2（点中本窗再按键/点鼠标）", 20, 36, 18, 230, 230, 230, 255)
        R.绘文字("最近raylib键码=" & 字(最近键), 20, 100, 18, 150, 220, 255, 255)
        R.绘文字("最近播放音效=" & 字(最近音效), 20, 140, 18, 180, 255, 180, 255)
        R.绘文字("键盘静音=" & 字(状态.取键盘静音()) & "   鼠标静音=" & 字(状态.取鼠标静音()), 20, 190, 15, 200, 200, 200, 255)
        R.绘文字("ESC 退出", 20, 235, 14, 150, 150, 160, 255)
        R.结束绘图()
    }

    遍历 n 于 音效编号 {
        若 表.包含?(n) {
            R.释音效(表[n])
        }
    }
    R.关闭音频()
    R.关闭窗口()
}
