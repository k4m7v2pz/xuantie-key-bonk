// 窗口.xt — M2 窗口内降级版主循环（macOS，渲染库 raylib）
//
// 定位：M3 全局 CGEventTap 工具链未通之前的备用练手版。
// 只在【点中本窗口、窗口聚焦】时响应按键/鼠标，不是全局监听（那是 M3）。
// 音源临时用渲染库零资产合成音（R.合成音效），正式版换音频库 播放(预加载ID)。
// 键码为 raylib/GLFW 键码，非 Windows VK；M2 只验证"事件→静音判断→发声"链路，不做键码映射。

引 "渲染" 予 R
引 "./输入.xt" 予 输入
引 "./状态.xt" 予 状态

公 函 运行() {
    R.初始化窗口(440, 260, "KeyBonk M2 窗口内降级版")
    R.初始化音频()

    // 启动时合成两个固定提示音句柄，避免每帧新建造成泄漏
    设 键盘音 = R.合成音效(440, 120)
    设 鼠标音 = R.合成音效(300, 120)
    设 最近键 = 0

    当 非 R.窗口应关闭?() {
        // 取队列里所有刚按下的键（取按键 返回 0 表示队列空）
        设 k = R.取按键()
        当 k != 0 {
            最近键 = k
            // 静音判断走状态层，与 C++ 钩子层一致；放行才交输入模块并播音
            若 非 状态.取键盘静音() {
                输入.键盘按下(k)
                R.播音效(键盘音)
            }
            k = R.取按键()
        }

        // 鼠标左键(0)/右键(1)刚按下
        若 非 状态.取鼠标静音() {
            若 R.鼠标刚按下?(0) 或 R.鼠标刚按下?(1) {
                输入.鼠标按下()
                R.播音效(鼠标音)
            }
        }

        R.开始绘图()
        R.清背景(24, 24, 30, 255)
        R.绘文字("KeyBonk M2 窗口内降级版（点中本窗再按键/点鼠标）", 20, 36, 18, 230, 230, 230, 255)
        R.绘文字("最近键码=" & 字(最近键), 20, 100, 18, 150, 220, 255, 255)
        R.绘文字("键盘静音=" & 字(状态.取键盘静音()) & "   鼠标静音=" & 字(状态.取鼠标静音()), 20, 150, 16, 200, 200, 200, 255)
        R.绘文字("ESC 退出", 20, 200, 14, 150, 150, 160, 255)
        R.结束绘图()
    }

    R.释音效(键盘音)
    R.释音效(鼠标音)
    R.关闭音频()
    R.关闭窗口()
}
