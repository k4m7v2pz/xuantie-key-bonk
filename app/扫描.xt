// 扫描.xt — 音频库目录预加载（对照 C++ main.cpp 的 preloadAudio）
//
// C++ 流程：递归遍历 audioLibPath → 仅普通 .wav → 文件名(去扩展名)纯数字 →
//          stoi → 0..255 → yumo::preloadAudio 等完成 → audioList[key]=audioID → 置完成标志。
//
// 本版边界：玄铁当前无内建目录递归列举，"枚举 wav 清单"留占位（M1 用 执(find/ls) 或 FFI）；
// 纯数字过滤、0..255 校验、登记、完成标志等可移植逻辑已落地。

引 "./状态.xt" 予 状态

设 数字字符 = "0123456789"

// 取路径末段文件名（兼容 / 与 \，对照 C++ 的 path.stem 之前先取文件名）
公 函 取文件名(全路径: 字): 字 {
    设 斜杠 = 全路径.倒找("/")
    设 反斜杠 = 全路径.倒找("\\")
    设 切点 = 斜杠
    若 反斜杠 > 切点 { 切点 = 反斜杠 }
    若 切点 < 0 { 返 全路径 }
    返 全路径.截取(切点 + 1, 全路径.字符数)
}

// 去扩展名（去掉最后一个 "." 及其后内容），对照 path.stem()
公 函 去扩展名(文件名: 字): 字 {
    设 点 = 文件名.倒找(".")
    若 点 < 0 { 返 文件名 }
    返 文件名.截取(0, 点)
}

// 是否纯数字（逐字符落在 0-9），对照 std::all_of(iswdigit)
公 函 纯数字?(文本: 字): 逻辑 {
    若 文本.字符数 == 0 { 返 假 }
    设 i = 0
    当 i < 文本.字符数 {
        设 位 = 文本.截取(i, i + 1)
        若 数字字符.包含?(位) == 假 {
            返 假
        }
        i = i + 1
    }
    返 真
}

// 处理单个 wav 全路径：校验纯数字键值 0..255 后登记（预加载调用待音频接入）
公 函 处理wav(全路径: 字) {
    设 文件名 = 取文件名(全路径)
    设 键文本 = 去扩展名(文件名)
    若 非 纯数字?(键文本) {
        返
    }
    设 转换 = 整(键文本)
    若 非 转换.成功 {
        返
    }
    设 vk = 转换.值
    若 vk < 0 或 vk > 255 {
        返
    }
    // TODO(音频接入闭环后)：音频.预加载(全路径) 取预加载ID，成功后 状态.登记预加载(vk, ID)。
    // 对照 C++：yumo::preloadAudio(全路径,&ready) 等待 ready 后写 audioList[key]=audioID。
}

// 预加载整个音频库目录（对照 preloadAudio 主体）
// TODO(M1)：此处枚举递归 wav 清单（执 find/ls -R 或 FFI readdir），逐个交 处理wav；
// 全部处理完调 状态.置预加载完成()，对照 C++ 的 audioPreloadReady.store(true)。
公 函 预加载全部(目录: 字) {
    // 枚举占位：得到 [全路径, ...] 后遍历调用 处理wav(全路径)
    状态.置预加载完成()
}
